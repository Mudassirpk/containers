local.file_match "nestjs_logs" {
  path_targets = [
    {
      __path__ = "/var/log/nestjs/*.log",
      job      = "nestjs",
    },
  ]
}

loki.source.file "nestjs_logs" {
  targets    = local.file_match.nestjs_logs.targets
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
